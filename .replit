modules = ["python-3.11", "nodejs-20", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "proj", "tcl", "tk", "zlib"]

[agent]
expertMode = true
integrations = ["github:1.0.0", "javascript_object_storage:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smoke"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "gunicorn --bind 0.0.0.0:5000 --reuse-port --timeout 120 --workers 2 --preload --config gunicorn.conf.py app:app"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python tests/smoke_test.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python tests/api_test.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Backfill Retry"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "nice -n 19 python -u sync_batch.py --retry-failures --master-only --sleep 0.8"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Fast Sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u sync_batch.py --months 60 --master-only"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Fill PK"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u backfill_title_info.py --fill-pk --sleep 0.2"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "BRHUB Sync"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env DATABASE_URL=\"$PROD_DATABASE_URL\" nice -n 19 python -u sync_brhub.py --end-idx 8877 --progress-key brhub_rescan_progress --status-key brhub_rescan_status --daily-cap 7976 --sleep 1.0"

[[workflows.workflow]]
name = "Merge Dev→Prod (dry-run)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u merge_dev_to_prod.py --dry-run"

[[workflows.workflow]]
name = "Merge Dev→Prod (실제반영)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u merge_dev_to_prod.py"

[[workflows.workflow]]
name = "Backfill General Lodging"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env DATABASE_URL=\"$PROD_DATABASE_URL\" python -u sync_lodgings.py --include-camping"

[[workflows.workflow]]
name = "Prewarm Unit Areas"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "nice -n 19 python -u prewarm_unit_areas.py --sleep 0.3 --daily-cap 2000"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
BJDONG_CODE_CSV = "법정동코드_전체자료.zip"
PUBLIC_BASE_URL = "https://homenstay.com"
SITE_URL = "https://homenstay.com"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "scripts/start-prod.sh"]
build = ["npm", "run", "build:frontend"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8008
externalPort = 8008

[objectStorage]
defaultBucketID = "replit-objstore-53e4a388-4065-4e16-9794-963b8aab532e"



[[workflows.workflow]]
name = "Weekly Digest"
author = "agent"
schedule = "0 1 * * 5"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python weekly_digest.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Deal Alert Digest"
author = "agent"
schedule = "0 0 * * *"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python deal_alert_digest.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "정기 API 통합 동기화"
author = "agent"
schedule = "30 2 * * *"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = 'env DATABASE_URL="$PROD_DATABASE_URL" nice -n 10 python -u scheduled_sync.py --status-key scheduled_sync_status --skip-stage transactions --skip-stage rural --skip-stage hanok'

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "최근 실거래 자동 동기화"
author = "agent"
schedule = "0 2 * * *"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = 'env DATABASE_URL="$PROD_DATABASE_URL" nice -n 10 python -u scheduled_sync.py --stage transactions --status-key scheduled_sync_status:transactions --orchestrated'

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "농어촌민박 자동 동기화"
author = "agent"
schedule = "10 2 * * *"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = 'env DATABASE_URL="$PROD_DATABASE_URL" nice -n 10 python -u scheduled_sync.py --stage rural --status-key scheduled_sync_status:rural --orchestrated'

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "한옥체험업 자동 동기화"
author = "agent"
schedule = "10 2 * * *"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = 'env DATABASE_URL="$PROD_DATABASE_URL" nice -n 10 python -u scheduled_sync.py --stage hanok --status-key scheduled_sync_status:hanok --orchestrated'

[workflows.workflow.metadata]
outputType = "console"
